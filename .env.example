# Скопируй в .env — приложение само его прочитает (python-dotenv).

SECRET_KEY=change-me

# PostgreSQL. Формат: postgresql+asyncpg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
# Роль и базу bulboz создаёт ./scripts/setup_local_pg.sh (Homebrew Postgres на Mac, Linux).
# В проде ходим через PgBouncer — там обычно порт 6432.
DATABASE_URL=postgresql+asyncpg://bulboz:bulboz@localhost:5432/bulboz

# Redis. Для разработки без Redis: REDIS_URL=memory://  (нужен pip install fakeredis)
REDIS_URL=redis://localhost:6379/0

# Web Push (VAPID) — необязательно. Без ключей сайт и внутренние уведомления (/notifications)
# работают как обычно, но браузеры не получают push, а кнопка в /settings → «🔔 Уведомления» выключена.
# Ключи генерируются один раз командой (из папки приложения): flask --app app generate-vapid
# В проде это /srv/bulboz/app/.env, куда строки VAPID_* дописывает scripts/deploy.sh
# (существующие значения он не перезаписывает и новые ключи не создаёт).
# VAPID_SUBJECT — реальный контакт владельца домена (RFC 8292). Пример ниже — заглушка:
# замени на свой адрес, иначе push-сервисы отклонят отправку.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=base64:<приватный-ключ-из-вывода-команды>
VAPID_SUBJECT=mailto:CHANGE-ME@example.com

# Отправку напоминаний и очереди push выполняет один планировщик каждые 5 минут:
#   flask --app app run-notification-jobs
# deploy.sh ставит systemd-таймер bulboz-notifications.timer от пользователя bulboz;
# вручную — cron: */5 * * * * bulboz cd /srv/bulboz/app && .../flask --app app run-notification-jobs

KREMLE_AUTO_GUARD=1
# Показывать тестовые аккаунты на странице входа — ТОЛЬКО для разработки
# DEMO_MODE=1
